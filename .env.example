# 微信公众号凭据（复制为 .env 后填写，.env 已被 git 忽略）
# 获取路径：mp.weixin.qq.com → 设置与开发 → 基本配置
WECHAT_APP_ID=你的AppID
WECHAT_APP_SECRET=你的AppSecret

# ── 可选：留言开关默认值（改写工具内置默认，单次调用仍可用参数覆盖）──
# 优先级：工具入参 > 此处 > 内置默认
# 接受 1/0/true/false（不区分大小写），留空或不写即用内置默认
# 内置默认：开启留言（need_open_comment=1）、不限制仅粉丝（only_fans_can_comment=0）
#WECHAT_NEED_OPEN_COMMENT=1
#WECHAT_ONLY_FANS_CAN_COMMENT=0
